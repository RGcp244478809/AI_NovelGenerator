# 此文件只列出示例；应用不会自动加载 .env。请在进程、容器或 NAS 面板中设置这些变量。
NOVEL_GENERATOR_AUTH_USERNAME=admin

# 二选一：生产环境优先使用 PASSWORD_HASH；不要同时设置 PASSWORD。
# 运行 `python -m backend.auth hash-password` 可交互生成摘要。
NOVEL_GENERATOR_AUTH_PASSWORD_HASH=pbkdf2_sha256$600000$replace_with_salt$replace_with_digest
# NOVEL_GENERATOR_AUTH_PASSWORD=replace-with-at-least-12-characters

# 至少 32 个随机字符；设置后，服务重启不会让已有会话全部失效。
NOVEL_GENERATOR_AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# HTTPS 部署必须为 true；本机纯 HTTP 调试时使用 false。
NOVEL_GENERATOR_AUTH_COOKIE_SECURE=true

# 可选，默认 43200 秒（12 小时），允许范围 300 到 2592000。
NOVEL_GENERATOR_AUTH_SESSION_TTL_SECONDS=43200
